+    EastAsianIme {
+        id: eastAsianIme
+    }
+
+    function updateEastAsianUi(edit) {
+        _imeCandidates = edit.candidates || [];
+        _imeActive = edit.active || false;
+    }
+
+    function scheduleEastAsianEdit(edit, rawDelta, replacement) {
+        if (!edit.handled) {
+            return false;
+        }
+        updateEastAsianUi(edit);
+        const language = virtualKeyboard.language;
+        const replacementText = replacement === undefined ? edit.replacement : replacement;
+        Qt.callLater(function() {
+            if (virtualKeyboard.language !== language) {
+                return;
+            }
+            const currentLength = Math.max(0, edit.oldLength + rawDelta);
+            virtualKeyboard.insertText(replacementText, -currentLength, currentLength);
+        });
+        return true;
+    }
+
+    function commitEastAsianNow() {
+        if (!_imeActive || !_isEastAsianLanguage) {
+            return;
+        }
+        const edit = eastAsianIme.commit(virtualKeyboard.language);
+        if (edit.handled) {
+            virtualKeyboard.insertText(edit.replacement, -edit.oldLength, edit.oldLength);
+        }
+        updateEastAsianUi(edit);
+    }
+
+    function resetEastAsianInput() {
+        updateEastAsianUi(eastAsianIme.reset());
+    }
+
+    function selectEastAsianCandidate(index) {
+        const edit = eastAsianIme.selectCandidate(virtualKeyboard.language, index);
+        scheduleEastAsianEdit(edit, 0);
+    }
+
+    function handleEastAsianKey(key, symbols) {
+        if (!eastAsianIme.supports(virtualKeyboard.language)) {
+            resetEastAsianInput();
+            return false;
+        }
+
+        if (key.type === VirtualKeyboardKey.Shift) {
+            return false;
+        }
+        if (key.type === VirtualKeyboardKey.Language) {
+            commitEastAsianNow();
+            return false;
+        }
+        if (key.type === VirtualKeyboardKey.Backspace) {
+            return scheduleEastAsianEdit(
+                eastAsianIme.backspace(virtualKeyboard.language), -1);
+        }
+        if (key.type === VirtualKeyboardKey.Space) {
+            return scheduleEastAsianEdit(
+                eastAsianIme.space(virtualKeyboard.language), 1);
+        }
+        if (key.type === VirtualKeyboardKey.Enter) {
+            commitEastAsianNow();
+            return false;
+        }
+
+        const symbol = symbols.length > 0 ? symbols[0] : "";
+        const edit = eastAsianIme.type(virtualKeyboard.language, symbol);
+        if (edit.handled) {
+            return scheduleEastAsianEdit(edit, symbol.length);
+        }
+        if (_imeActive && symbol.length > 0) {
+            const commitEdit = eastAsianIme.commit(virtualKeyboard.language);
+            return scheduleEastAsianEdit(
+                commitEdit, symbol.length, commitEdit.replacement + symbol);
+        }
+        return false;
+    }
+
+    function resetHangulComposition() {
+        _hangulState = Hangul.emptyState();
+    }
+
+    function handleHangulKey(key, symbols) {
+        if (virtualKeyboard.language !== "ko_KR") {
+            resetHangulComposition();
+            return;
+        }
+
+        if (key.type === VirtualKeyboardKey.Shift) {
+            return;
+        }
+
+        if (key.type === VirtualKeyboardKey.Backspace
+                || key.type === VirtualKeyboardKey.Language) {
+            resetHangulComposition();
+            return;
+        }
+
+        const symbol = symbols.length > 0 ? symbols[0] : "";
+        if (!Hangul.isJamo(symbol)) {
+            resetHangulComposition();
+            return;
+        }
+
+        const edit = Hangul.feed(_hangulState, symbol);
+        _hangulState = edit.state;
 
+        // Xochitl inserts the raw key before this queued correction. Replace
+        // that jamo, plus the active composition when needed, with NFC Hangul.
+        if (edit.replacePrevious === 0 && edit.text === symbol) {
+            return;
+        }
+        Qt.callLater(function() {
+            if (virtualKeyboard.language !== "ko_KR") {
+                return;
+            }
+            const deleteCount = edit.replacePrevious + 1;
+            virtualKeyboard.insertText(edit.text, -deleteCount, deleteCount);
+        });
+    }
